#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>

/ {
	chosen {
		/* Build a standalone image at flash offset 0 for first SWD bring-up. */
		/delete-property/ zephyr,code-partition;
		/delete-property/ zephyr,console;
		/delete-property/ zephyr,shell-uart;
		/delete-property/ zephyr,uart-mcumgr;
		/delete-property/ zephyr,bt-mon-uart;
		/delete-property/ zephyr,bt-c2h-uart;

		/* nRF52811.dtsi points this at bt_hci_sdc by default. */
		zephyr,bt-hci = &bt_hci_controller;
	};

	zephyr,user {
		epd-cs-gpios = <&gpio0 6 GPIO_ACTIVE_LOW>;
		epd-dc-gpios = <&gpio0 5 GPIO_ACTIVE_HIGH>;
		epd-reset-gpios = <&gpio0 4 GPIO_ACTIVE_LOW>;
		/* Existing firmware waits while the physical BUSY line is low. */
		epd-busy-gpios = <&gpio0 3 GPIO_ACTIVE_LOW>;
		epd-bs-gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;
		epd-enable-gpios = <&gpio0 7 GPIO_ACTIVE_HIGH>;
	};
};

&pinctrl {
	epd_spi_default: epd_spi_default {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 0, 19)>,
				<NRF_PSEL(SPIM_MOSI, 0, 20)>,
				<NRF_PSEL_DISCONNECTED(SPIM_MISO)>;
		};
	};

	epd_spi_sleep: epd_spi_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 0, 19)>,
				<NRF_PSEL(SPIM_MOSI, 0, 20)>,
				<NRF_PSEL_DISCONNECTED(SPIM_MISO)>;
			low-power-enable;
		};
	};
};

&uart0 {
	status = "disabled";
};

&i2c0 {
	status = "disabled";
};

&pwm0 {
	status = "disabled";
};

&spi0 {
	status = "disabled";
};

&spi1 {
	compatible = "nordic,nrf-spi";
	status = "okay";
	pinctrl-0 = <&epd_spi_default>;
	pinctrl-1 = <&epd_spi_sleep>;
	pinctrl-names = "default", "sleep";
};

/* nRF52811 defaults to Nordic's SoftDevice Controller in NCS 3.4.
 * The Zephyr split Link Layer uses less RAM, which matters on the 24 KiB part.
 */
&bt_hci_sdc {
	status = "disabled";
};

&bt_hci_controller {
	status = "okay";
};
